#define OFFLINE_BEEP_ENABLE     @OFFLINE_BEEP_ENABLE@
#define OFFLINE_TASK_STACK_SIZE @OFFLINE_TASK_STACK_SIZE@
#define OFFLINE_TASK_PRIORITY   @OFFLINE_TASK_PRIORITY@

/* REMOTE 参数 */
